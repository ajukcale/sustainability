# PostgreSQL (docker-compose default)
DATABASE_URL="postgresql://sustainability:sustainability@localhost:5432/sustainability?schema=public"

# App
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth
BETTER_AUTH_SECRET="replace-with-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# MFA stub / config flag (Phase 1 — enforcement is flag-only)
AUTH_MFA_REQUIRED="false"

# Optional SMTP for invites (if unset, invite links are logged to console)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="noreply@example.com"
